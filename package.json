{
  "name": "edge-tts-pipeline",
  "version": "0.1.0",
  "description": "Production-grade free TTS pipeline: EdgeTTS synthesis behind a content-addressed cache (server) plus an LRU-prefetching singleton player (client). Same sentence is synthesized exactly once.",
  "keywords": [
    "tts",
    "text-to-speech",
    "edgetts",
    "edge-tts",
    "cache",
    "audio",
    "nextjs",
    "supabase",
    "speech"
  ],
  "license": "MIT",
  "author": "EdgeTtsPipeline Authors",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "msedge-tts": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "msedge-tts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@types/node": "^22.10.2",
    "msedge-tts": "^2.0.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
